# Copiar a .env.local para desarrollo. Nada de esto es secreto.

# Backend para el proxy de desarrollo (stack-line-services).
VITE_DEV_API_TARGET=http://localhost:8080

# Registro integrado de WhatsApp (Meta Embedded Signup) bajo la app de Meta de
# Stackline. Ambos son públicos (van en el navegador); el secreto de la app y
# los tokens de cada número viven solo en el backend.
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
